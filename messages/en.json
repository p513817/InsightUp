                 "intro":  {
                               "title":  "InsightUp Product Intro",
                               "description":  "Turn InBody records into readable trend views so you can quickly understand changes, preserve context, and build a more consistent tracking habit.",
                               "sections":  {
                                                "insightTitle":  "Understand changes faster",
                                                "insightBody":  "Dashboard gives each card a single job so signals do not get mixed together.",
                                                "controlTitle":  "Manage the data context",
                                                "controlBody":  "Records handles create, edit, and chart-inclusion rules in one place so tracking stays clean.",
                                                "evidenceTitle":  "Keep proof of progress",
                                                "evidenceBody":  "Excluding a record from charts is not the same as deleting it. The full history stays available for comparison.",
                                                "workflowTitle":  "From record to decision, the flow stays simple.",
                                                "workflowBody":  "Use Records to organize InBody data, then open Dashboard to review trends. The split keeps the mental model simple and matches daily usage.",
                                                "step1":  "Add or update records",
                                                "step2":  "Decide what enters analysis",
                                                "step3":  "Read trends in Dashboard",
                                                "audienceTitle":  "Built for people who want to track consistently without getting buried in data.",
                                                "audienceBody1":  "You measure InBody regularly and want to know quickly whether the latest change is worth reading into.",
                                                "audienceBody2":  "You mainly review records on mobile and want the first screen after login to be useful.",
                                                "audienceBody3":  "You want to keep the full history while controlling which records enter chart analysis.",
                                                "principlesTitle":  "Product principles",
                                                "principle1Title":  "Read trends first, organize later",
                                                "principle1Body":  "Dashboard is optimized for interpretation, not for mixing in maintenance tasks.",
                                                "principle2Title":  "Exclude from analysis does not mean delete",
                                                "principle2Body":  "The product keeps the full record history so you can adjust chart signals without losing context.",
                                                "principle3Title":  "Mobile-first does not mean simplified",
                                                "principle3Body":  "Important information is compressed into easy-to-read surfaces, while deeper context lives in secondary pages.",
                                                "rulesTitle":  "Data rules",
                                                "rule1Title":  "Keep everything",
                                                "rule1Body":  "Raw measurements stay in the database and do not disappear when excluded from charts.",
                                                "rule2Title":  "Control the analysis",
                                                "rule2Body":  "You decide which records appear in charts and which stay as background reference.",
                                                "rule3Title":  "Scan conservatively",
                                                "rule3Body":  "Photo scan remains review-first so incorrect data does not contaminate the main chart surface."
                                            }
                           }
             },
