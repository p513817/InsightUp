NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
GEMINI_API_KEY=your-gemini-api-key

# Local/Preview E2E persona login. Never enable this in Vercel Production.
E2E_TEST_AUTH_ENABLED=false
E2E_TEST_AUTH_SECRET=replace-with-long-random-secret
E2E_TEST_USER_PASSWORD=optional-separate-test-user-password
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
